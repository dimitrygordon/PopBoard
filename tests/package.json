{
  "name": "popboard-rules-tests",
  "private": true,
  "type": "module",
  "description": "Security-rules tests for PopBoard. Runs entirely on local Firebase emulators (no Firebase login needed).",
  "scripts": {
    "test": "firebase emulators:exec --project demo-popboard --only firestore,storage --config ../firebase.json \"node --test rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --project hotseat-4f661 --only auth,firestore,storage --config ../firebase.json \"node e2e-smoke.mjs\"",
    "test:rbmk": "node --test rbmk-physics.test.mjs rbmk-v2.test.mjs",
    "test:pendulum": "node --test pendulum-physics.test.mjs",
    "test:machines": "node --test machines-physics.test.mjs",
    "test:relativity": "node --test relativity-physics.test.mjs",
    "test:mechanics": "node --test mechanics-physics.test.mjs",
    "test:orbits": "node --test orbits-physics.test.mjs",
    "test:exoplanets": "node --test exoplanets-physics.test.mjs",
    "test:doublependulum": "node --test double-pendulum-physics.test.mjs",
    "test:emspec": "node --test emspec-physics.test.mjs",
    "test:stars": "node --test stars-physics.test.mjs",
    "test:projectile": "node --test projectile-physics.test.mjs",
    "test:emfields": "node --test emfields-physics.test.mjs",
    "test:waves": "node --test waves-physics.test.mjs",
    "test:gasthermo": "node --test gas-thermo-physics.test.mjs",
    "test:momentum": "node --test momentum-physics.test.mjs",
    "test:induction": "node --test induction-physics.test.mjs",
    "test:optics": "node --test optics-physics.test.mjs",
    "test:rocket": "node --test rocket-physics.test.mjs",
    "test:quantum": "node --test quantum-physics.test.mjs",
    "test:climate": "node --test climate-physics.test.mjs",
    "test:platetectonics": "node --test plate-tectonics.test.mjs",
    "test:mechanics:browser": "node mechanics-browser.mjs",
    "test:pdf": "node --test pdf-export.test.mjs",
    "test:return": "node --test board-return.test.mjs",
    "test:study": "node --test study-portal.test.mjs",
    "test:study:browser": "node study-guest-browser.mjs",
    "test:return:browser": "firebase emulators:exec --project hotseat-4f661 --only auth,firestore,storage --config ../firebase.json \"node board-return-browser.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0",
    "puppeteer-core": "^23.0.0"
  }
}
