rules_version = '2';

// PopBoard Storage rules: post/reply images live under boards/{boardId}/...
// Only signed-in members (or the board's teacher) can upload, only images,
// and only up to 5 MB. Signed-in users can view them.
service firebase.storage {
  match /b/{bucket}/o {
    function boardDoc(boardId) {
      return firestore.get(/databases/(default)/documents/boards/$(boardId));
    }
    function isOwner(boardId) {
      return boardDoc(boardId).data.get('ownerUid', '') == request.auth.uid;
    }
    function isMember(boardId) {
      return firestore.exists(/databases/(default)/documents/boards/$(boardId)/members/$(request.auth.uid));
    }
    function isAdmin() {
      return firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /boards/{boardId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (isMember(boardId) || isOwner(boardId) || isAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if request.auth != null && (isOwner(boardId) || isAdmin());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
